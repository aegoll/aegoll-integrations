    "rules": 12,
    "ruleList": [
      {
        "id": "deny-sanctioned",
        "priority": 0,
        "verdict": "REJECT",
        "condition": "vendor.sanctioned",
        "reason": "sanctioned counterparty"
      },
      {
        "id": "deny-over-balance",
        "priority": 5,
        "verdict": "REJECT",
        "condition": "not budget.ok and budget.binding is one of balance, emergency_reserve",
        "reason": "insufficient treasury balance"
      },
      {
        "id": "internal-approve-within-budget",
        "priority": 8,
        "verdict": "APPROVE",
        "condition": "channel is internal and budget.ok",
        "reason": "token budget available for this run"
      },
      {
        "id": "internal-reject-over-budget",
        "priority": 9,
        "verdict": "REJECT",
        "condition": "channel is internal and not budget.ok",
        "reason": "token budget exhausted -- the run must not start"
      },
      {
        "id": "review-budget-exhausted",
        "priority": 10,
        "verdict": "REVIEW",
        "condition": "not budget.ok",
        "reason": "outside a budget envelope"
      },
      {
        "id": "escalate-high-risk",
        "priority": 20,
        "verdict": "ESCALATE",
        "condition": "risk.score is at least 0.6",
        "reason": "risk score above tolerance"
      },
      {
        "id": "review-untrusted-vendor-nontrivial",
        "priority": 30,
        "verdict": "REVIEW",
        "condition": "trust.score is under 0.4 and amount_usd is at least 1.0",
        "reason": "low vendor trust for a non-trivial amount"
      },
      {
        "id": "review-large",
        "priority": 40,
        "verdict": "REVIEW",
        "condition": "amount_usd is at least 100.0",
        "reason": "amount at or above the review threshold"
      },
      {
        "id": "review-negative-roi",
        "priority": 50,
        "verdict": "REVIEW",
        "condition": "roi.known and roi.ratio is under 1.0 and amount_usd is at least 1.0",
        "reason": "expected value below cost"
      },
      {
        "id": "auto-approve-micro",
        "priority": 100,
        "verdict": "APPROVE",
        "condition": "amount_usd is under 1.0 and risk.score is under 0.35 and budget.ok",
        "reason": "micro-transaction inside all envelopes"
      },
      {
        "id": "approve-trusted-moderate",
        "priority": 200,
        "verdict": "APPROVE",
        "condition": "amount_usd is under 25.0 and trust.score is at least 0.7 and risk.score is under 0.4 and budget.ok",
        "reason": "trusted vendor, moderate amount"
      },
      {
        "id": "default-review",
        "priority": 9999,
        "verdict": "REVIEW",
        "condition": "always",
        "reason": "no rule matched; defaulting to review"
      }
    ]
  },
