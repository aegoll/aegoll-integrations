# Copy to .env. Never commit .env.
#
# Invariant: BYOK keys are never stored by the layer, never logged, and never
# written to the evidence journal. A masked display path is the only way a key
# is ever shown. This file exists so every key has a documented name and no
# example carries a real value.

# --- model providers (one per framework; you only need the ones you run) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- the x402 seller these examples buy from ---
# Point at the TypeScript seller in Jayzilva/x402 (npm run server), or at any
# other x402 resource server.
X402_SELLER_URL=http://127.0.0.1:4021

# --- wallet, for the real-settlement variants only ---
# Every quickstart works against a mock seller with no wallet and no testnet.
# Leave this empty unless you are deliberately running real settlement.
# Testnet only. Never put a mainnet key here.
X402_PRIVATE_KEY=
X402_NETWORK=base-sepolia

# --- governance ---
# Path to the policy pack and config the examples govern with. Defaults to the
# repo's own starter if unset.
AEGOLL_CONFIG=./aegoll.yaml
